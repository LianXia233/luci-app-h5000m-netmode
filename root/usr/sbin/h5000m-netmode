#!/bin/sh

TAG="h5000m-netmode"
LOCK_DIR="/var/lock/h5000m-netmode.lock"
DAED_EXIT_STATE_FILE="/var/run/h5000m-netmode.daed-exit"

mode="$(uci -q get h5000m_netmode.settings.mode || echo wan_first)"

normalize_mode() {
	case "$mode" in
		wan_first|modem_first|wan_only|modem_only) ;;
		*) mode="wan_first" ;;
	esac
}

bool_value() {
	case "$1" in
		1|true) echo 1 ;;
		*) echo 0 ;;
	esac
}

interface_exists() {
	uci -q get "network.$1" >/dev/null 2>&1
}

append_modem_section() {
	local section="$1"
	[ -n "$section" ] || return 0
	case " $MODEM_SECTIONS " in
		*" $section "*) ;;
		*) MODEM_SECTIONS="${MODEM_SECTIONS:+$MODEM_SECTIONS }$section" ;;
	esac
}

discover_modem_interfaces() {
	local section device eth_fallback

	MODEM_SECTIONS=""
	MODEM_PRIMARY=""
	MODEM6_PRIMARY=""

	eth_fallback="$(uci -q get h5000m_netmode.settings.eth_fallback || true)"

	for section in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.]*\)=interface$/\1/p'); do
		device="$(uci -q get "network.${section}.device" || uci -q get "network.${section}.ifname" || true)"

		case "$section" in
			wan|wan6|loopback|lan) continue ;;
		esac

		case " $eth_fallback " in
			*" $section "*) continue ;;
		esac

		case "$device" in @wan|@wan6) continue ;; esac

		append_modem_section "$section"
		[ -n "$MODEM_PRIMARY" ] || MODEM_PRIMARY="$section"
	done

	if [ -n "$MODEM_PRIMARY" ]; then
		for section in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.]*\)=interface$/\1/p'); do
			device="$(uci -q get "network.${section}.device" || uci -q get "network.${section}.ifname" || true)"
			[ "$device" = "@${MODEM_PRIMARY}" ] || continue
			append_modem_section "$section"
			[ -n "$MODEM6_PRIMARY" ] || MODEM6_PRIMARY="$section"
		done
	fi
}
read_interface() {
	local name="$1" json value

	IFACE_PRESENT=0
	IFACE_UP=0
	IFACE_AVAILABLE=0
	IFACE_DEVICE=""
	interface_exists "$name" && IFACE_PRESENT=1

	json="$(ubus call "network.interface.$name" status 2>/dev/null || true)"
	[ -n "$json" ] || {
		IFACE_DEVICE="$(uci -q get "network.$name.device" || uci -q get "network.$name.ifname" || true)"
		return 0
	}

	value="$(printf '%s' "$json" | jsonfilter -e '@.up' 2>/dev/null || true)"
	IFACE_UP="$(bool_value "$value")"
	value="$(printf '%s' "$json" | jsonfilter -e '@.available' 2>/dev/null || true)"
	IFACE_AVAILABLE="$(bool_value "$value")"
	IFACE_DEVICE="$(printf '%s' "$json" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
	[ -n "$IFACE_DEVICE" ] || IFACE_DEVICE="$(printf '%s' "$json" | jsonfilter -e '@.device' 2>/dev/null || true)"
	[ -n "$IFACE_DEVICE" ] || IFACE_DEVICE="$(uci -q get "network.$name.device" || uci -q get "network.$name.ifname" || true)"
}

route_device() {
	printf '%s\n' "$1" | sed -n 's/.* dev \([^ ]*\).*/\1/p'
}

has_default_route() {
	local family="$1" device="$2"
	[ -n "$device" ] || return 1
	ip "-${family}" route show default 2>/dev/null | awk -v device="$device" '
		{
			for (i = 1; i < NF; i++)
				if ($i == "dev" && $(i + 1) == device)
					found = 1
		}
		END { exit found ? 0 : 1 }
	'
}

device_matches() {
	local device="$1" candidate
	shift
	for candidate in "$@"; do
		[ -n "$candidate" ] && [ "$device" = "$candidate" ] && return 0
	done
	return 1
}

route_owner() {
	local device="$1"
	shift
	[ -n "$device" ] || { echo none; return 0; }
	if device_matches "$device" "$WAN_DEVICE" "$WAN6_DEVICE"; then
		echo wan
	elif device_matches "$device" "$MODEM_DEVICE" "$MODEM6_DEVICE"; then
		echo modem
	else
		echo other
	fi
}

store_daed_exit_state() {
	local owner="$1" temporary

	temporary="${DAED_EXIT_STATE_FILE}.new.$$"
	umask 077
	printf '%s\n' "$owner" > "$temporary" || return 1
	mv -f "$temporary" "$DAED_EXIT_STATE_FILE"
}

reload_daed_on_exit_change() {
	local current previous pid

	read_live_state
	current="$ACTIVE4"
	case "$current" in
		wan|modem) ;;
		*) return 0 ;;
	esac

	previous="$(cat "$DAED_EXIT_STATE_FILE" 2>/dev/null || true)"
	case "$previous" in
		wan|modem) ;;
		*)
			store_daed_exit_state "$current"
			logger -t "$TAG" "recorded initial daed IPv4 exit=$current"
			return 0
			;;
	esac
	[ "$previous" != "$current" ] || return 0

	# daed exposes hot reload only through its authenticated GraphQL API. Signals
	# and the generic OpenWrt reload action do not apply its selected profile, so
	# use the procd-managed restart path without coupling this service to daed
	# credentials. If daed is stopped, its next start will detect the live route.
	pid="$(pgrep -f '^/usr/bin/daed run([[:space:]]|$)' 2>/dev/null | head -n 1)"
	if [ -z "$pid" ]; then
		store_daed_exit_state "$current"
		logger -t "$TAG" "daed IPv4 exit changed ${previous}->${current}; daemon is not running"
		return 0
	fi
	if [ ! -x /etc/init.d/daed ] || ! /etc/init.d/daed restart >/dev/null 2>&1; then
		logger -t "$TAG" "failed to restart daed after IPv4 exit changed ${previous}->${current}"
		return 1
	fi
	store_daed_exit_state "$current" || return 1
	logger -t "$TAG" "restarted daed after IPv4 exit changed ${previous}->${current}"
	return 0
}

read_live_state() {
	local modem
	discover_modem_interfaces

	read_interface wan
	WAN_PRESENT="$IFACE_PRESENT"; WAN_UP="$IFACE_UP"; WAN_AVAILABLE="$IFACE_AVAILABLE"; WAN_DEVICE="$IFACE_DEVICE"
	read_interface wan6
	WAN6_PRESENT="$IFACE_PRESENT"; WAN6_UP="$IFACE_UP"; WAN6_AVAILABLE="$IFACE_AVAILABLE"; WAN6_DEVICE="$IFACE_DEVICE"
	read_interface "${MODEM_PRIMARY:-__missing_modem__}"
	MODEM_PRESENT="$IFACE_PRESENT"; MODEM_UP="$IFACE_UP"; MODEM_AVAILABLE="$IFACE_AVAILABLE"; MODEM_DEVICE="$IFACE_DEVICE"
	read_interface "${MODEM6_PRIMARY:-__missing_modem6__}"
	MODEM6_PRESENT="$IFACE_PRESENT"; MODEM6_UP="$IFACE_UP"; MODEM6_AVAILABLE="$IFACE_AVAILABLE"; MODEM6_DEVICE="$IFACE_DEVICE"

	# Override with manual device mapping from UCI
	local wan_dev_manual modem_dev_manual
	wan_dev_manual="$(uci -q get h5000m_netmode.settings.wan_device 2>/dev/null || true)"
	modem_dev_manual="$(uci -q get h5000m_netmode.settings.modem_device 2>/dev/null || true)"
	[ -n "$wan_dev_manual" ] && WAN_DEVICE="$wan_dev_manual"
	[ -n "$modem_dev_manual" ] && MODEM_DEVICE="$modem_dev_manual"

	# If no modem interface was found in UCI, try to detect the physical
	# 5G modem device through the MT5700M manager or any known USB helper.
	# This treats the modem as "present" (just disconnected) rather than
	# "not configured", giving clearer status in the dashboard.
	if [ "$MODEM_PRESENT" != "1" ]; then
		if [ -r /usr/share/mt5700m/usb.sh ]; then
			. /usr/share/mt5700m/usb.sh
			if mt5700m_usb_info >/dev/null 2>&1; then
				MODEM_PRESENT=1
				MODEM_DEVICE="$(mt5700m_netdev || true)"
				if [ -n "$MODEM_DEVICE" ] && [ -d "/sys/class/net/${MODEM_DEVICE}" ]; then
					ip -4 addr show dev "$MODEM_DEVICE" 2>/dev/null | grep -q 'inet ' && MODEM_UP=1
				fi
			fi
		elif [ -r /usr/share/qmodem/usb.sh ]; then
			. /usr/share/qmodem/usb.sh
			if qmodem_usb_info >/dev/null 2>&1; then
				MODEM_PRESENT=1
				MODEM_DEVICE="$(qmodem_netdev || true)"
				if [ -n "$MODEM_DEVICE" ] && [ -d "/sys/class/net/${MODEM_DEVICE}" ]; then
					ip -4 addr show dev "$MODEM_DEVICE" 2>/dev/null | grep -q 'inet ' && MODEM_UP=1
				fi
			fi
		fi
	fi

	DEFAULT4="$(ip -4 route show default 2>/dev/null | head -n 1)"
	DEFAULT6="$(ip -6 route show default 2>/dev/null | head -n 1)"
	ACTIVE4="$(route_owner "$(route_device "$DEFAULT4")")"
	ACTIVE6="$(route_owner "$(route_device "$DEFAULT6")")"
	WAN4_READY=0; WAN6_READY=0; MODEM4_READY=0; MODEM6_READY=0
	has_default_route 4 "$WAN_DEVICE" && WAN4_READY=1
	has_default_route 6 "${WAN6_DEVICE:-$WAN_DEVICE}" && WAN6_READY=1
	has_default_route 4 "$MODEM_DEVICE" && MODEM4_READY=1
	has_default_route 6 "${MODEM6_DEVICE:-$MODEM_DEVICE}" && MODEM6_READY=1
}

print_status() {
	local modem_metric ipv6_owner

	read_live_state
	ipv6_owner="$(uci -q get h5000m_netmode.settings.ipv6_owner || true)"
	modem_metric="$(uci -q get network.MT5700M.metric 2>/dev/null || uci -q get mt5700m.connection.metric 2>/dev/null || true)"

	echo "mode=$mode"
	echo "ipv6_policy=follow_preferred"
	echo "ipv6_owner=${ipv6_owner:-none}"
	echo "wan_present=$WAN_PRESENT"
	echo "wan_up=$WAN_UP"
	echo "wan6_up=$WAN6_UP"
	echo "wan4_ready=$WAN4_READY"
	echo "wan6_ready=$WAN6_READY"
	echo "wan_device=$WAN_DEVICE"
	echo "modem_present=$MODEM_PRESENT"
	echo "modem_up=$MODEM_UP"
	echo "modem6_up=$MODEM6_UP"
	echo "modem4_ready=$MODEM4_READY"
	echo "modem6_ready=$MODEM6_READY"
	echo "modem_device=$MODEM_DEVICE"
	echo "modem_interface=$MODEM_PRIMARY"
	echo "modem6_interface=$MODEM6_PRIMARY"
	echo "active4=$ACTIVE4"
	echo "active6=$ACTIVE6"
	echo "daed_exit_state=$(cat "$DAED_EXIT_STATE_FILE" 2>/dev/null || echo none)"
	echo "eth_fallback=$(uci -q get h5000m_netmode.settings.eth_fallback || true)"
	echo "wan_metric=$(uci -q get network.wan.metric || true)"
	echo "wan6_metric=$(uci -q get network.wan6.metric || true)"
	echo "usb_metric=$(uci -q get "network.${MODEM_PRIMARY}.metric" || true)"
	echo "usbv6_metric=$(uci -q get "network.${MODEM6_PRIMARY}.metric" || true)"
	echo "wan_defaultroute=$(uci -q get network.wan.defaultroute || echo 1)"
	echo "wan6_defaultroute=$(uci -q get network.wan6.defaultroute || echo 1)"
	echo "wan6_auto=$(uci -q get network.wan6.auto || echo 1)"
	echo "usb_defaultroute=$(uci -q get "network.${MODEM_PRIMARY}.defaultroute" || echo 1)"
	echo "usbv6_defaultroute=$(uci -q get "network.${MODEM6_PRIMARY}.defaultroute" || echo 1)"
	echo "usbv6_auto=$(uci -q get "network.${MODEM6_PRIMARY}.auto" || echo 1)"
	echo "modem_metric=$modem_metric"
	echo "default4=$DEFAULT4"
	echo "default6=$DEFAULT6"
}

set_network_option() {
	local section="$1" option="$2" value="$3"
	interface_exists "$section" || return 0
	uci -q set "network.${section}.${option}=${value}"
}

set_network_option_if_changed() {
	local section="$1" option="$2" value="$3" current
	interface_exists "$section" || return 0
	current="$(uci -q get "network.${section}.${option}" || true)"
	[ "$current" = "$value" ] && return 0
	uci -q set "network.${section}.${option}=${value}" || return 1
	NETWORK_CHANGED=1
}

select_ipv6_owner() {
	read_live_state
	case "$mode" in
		wan_only) IPV6_OWNER="wan" ;;
		modem_only) IPV6_OWNER="modem" ;;
		wan_first|modem_first)
			case "$ACTIVE4" in
				wan|modem) IPV6_OWNER="$ACTIVE4" ;;
				*) [ "$mode" = "modem_first" ] && IPV6_OWNER="modem" || IPV6_OWNER="wan" ;;
			esac
		;;
	esac
}

align_ipv6_to_active4() {
	local previous_owner

	select_ipv6_owner
	previous_owner="$(uci -q get h5000m_netmode.settings.ipv6_owner || true)"
	NETWORK_CHANGED=0

	case "$IPV6_OWNER" in
		modem)
			set_network_option_if_changed wan6 defaultroute 0 || return 1
			set_network_option_if_changed wan6 auto 0 || return 1
			[ -n "$MODEM6_PRIMARY" ] && set_network_option_if_changed "$MODEM6_PRIMARY" defaultroute 1 || true
			[ -n "$MODEM6_PRIMARY" ] && set_network_option_if_changed "$MODEM6_PRIMARY" auto 1 || true
			;;
		*)
			IPV6_OWNER="wan"
			set_network_option_if_changed wan6 defaultroute 1 || return 1
			set_network_option_if_changed wan6 auto 1 || return 1
			[ -n "$MODEM6_PRIMARY" ] && set_network_option_if_changed "$MODEM6_PRIMARY" defaultroute 0 || true
			[ -n "$MODEM6_PRIMARY" ] && set_network_option_if_changed "$MODEM6_PRIMARY" auto 0 || true
			;;
	esac

	if [ "$previous_owner" != "$IPV6_OWNER" ]; then
		uci -q set "h5000m_netmode.settings.ipv6_owner=${IPV6_OWNER}" || return 1
		uci -q commit h5000m_netmode || return 1
	fi
	[ "$NETWORK_CHANGED" = "0" ] || uci -q commit network || return 1

	case "$IPV6_OWNER" in
		modem)
			[ "$WAN6_UP" != "1" ] || ifdown wan6 >/dev/null 2>&1 || true
			if [ "$MODEM_UP" = "1" ] && [ "$MODEM6_UP" != "1" ] && [ -n "$MODEM6_PRIMARY" ]; then
				ifup "$MODEM6_PRIMARY" >/dev/null 2>&1 || true
			fi
			;;
		wan)
			[ "$MODEM6_UP" != "1" ] || ifdown "$MODEM6_PRIMARY" >/dev/null 2>&1 || true
			if [ "$WAN_UP" = "1" ] && [ "$WAN6_UP" != "1" ]; then
				ifup wan6 >/dev/null 2>&1 || true
			fi
			;;
	esac

	if [ "$previous_owner" != "$IPV6_OWNER" ]; then
		logger -t "$TAG" "IPv6 owner changed ${previous_owner:-none}->${IPV6_OWNER} active4=${ACTIVE4} mode=${mode}"
	fi
	return 0
}

acquire_lock() {
	local owner
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		echo "$$" > "$LOCK_DIR/pid"
		return 0
	fi
	owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
	case "$owner" in
		''|*[!0-9]*) owner="" ;;
	esac
	if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
		rm -rf "$LOCK_DIR" 2>/dev/null
		mkdir "$LOCK_DIR" 2>/dev/null || return 1
		echo "$$" > "$LOCK_DIR/pid"
		return 0
	fi
	return 1
}

release_lock() {
	rm -rf "$LOCK_DIR" 2>/dev/null
}

apply_policy() {
	local wan_metric modem_metric wan4_defaultroute wan6_defaultroute modem4_defaultroute modem6_defaultroute wan6_auto modem6_auto modem section device

	discover_modem_interfaces

	case "$mode" in
		modem_first)
			wan_metric=50; modem_metric=10
			wan4_defaultroute=1; wan6_defaultroute=0
			modem4_defaultroute=1; modem6_defaultroute=1
			wan6_auto=0; modem6_auto=1
			;;
		wan_only)
			wan_metric=10; modem_metric=50
			wan4_defaultroute=1; wan6_defaultroute=1
			modem4_defaultroute=0; modem6_defaultroute=0
			wan6_auto=1; modem6_auto=0
			;;
		modem_only)
			wan_metric=50; modem_metric=10
			wan4_defaultroute=0; wan6_defaultroute=0
			modem4_defaultroute=1; modem6_defaultroute=1
			wan6_auto=0; modem6_auto=1
			;;
		*)
			mode=wan_first
			wan_metric=10; modem_metric=50
			wan4_defaultroute=1; wan6_defaultroute=1
			modem4_defaultroute=1; modem6_defaultroute=0
			wan6_auto=1; modem6_auto=0
			;;
	esac

	# Preserve eth_fallback across policy changes.
	local saved_fallback
	saved_fallback="$(uci -q get h5000m_netmode.settings.eth_fallback || true)"
	uci -q set h5000m_netmode.settings='settings' || return 1
	uci -q set "h5000m_netmode.settings.mode=${mode}" || return 1
	[ -n "$saved_fallback" ] && uci -q set "h5000m_netmode.settings.eth_fallback=${saved_fallback}" || true
	uci -q commit h5000m_netmode || return 1

	set_network_option wan metric "$wan_metric" || return 1
	set_network_option wan6 metric "$wan_metric" || return 1
	set_network_option wan norelease 1 || return 1
	set_network_option wan defaultroute "$wan4_defaultroute" || return 1
	set_network_option wan6 defaultroute "$wan6_defaultroute" || return 1
	set_network_option wan6 auto "$wan6_auto" || return 1
	for section in $MODEM_SECTIONS; do
		set_network_option "$section" metric "$modem_metric" || return 1
		device="$(uci -q get "network.${section}.device" || uci -q get "network.${section}.ifname" || true)"
		if [ "$section" = "$MODEM6_PRIMARY" ] || [ "$device" = "@${MODEM_PRIMARY}" ]; then
			set_network_option "$section" defaultroute "$modem6_defaultroute" || return 1
			set_network_option "$section" auto "$modem6_auto" || return 1
		else
			set_network_option "$section" defaultroute "$modem4_defaultroute" || return 1
		fi
	done
	uci -q commit network || return 1

	if uci -q get mt5700m.connection >/dev/null 2>&1; then
		uci -q set "mt5700m.connection.metric=${modem_metric}" || return 1
		uci -q commit mt5700m || return 1
	fi
	return 0
}

normalize_mode
action="${1:-}"
case "$action" in
	status)
		print_status
		exit 0
		;;
	eth-candidates)
		uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.]*\)=interface$/\1/p' | while IFS= read -r section; do
			case "$section" in wan|wan6|loopback|lan) continue ;; esac
			printf '%s\n' "$section"
		done
		exit 0
		;;
	eth-fallback)
		case "${2:-}" in
			set)
				shift 2
				uci -q set "h5000m_netmode.settings.eth_fallback=${*}" || exit 1
				uci -q commit h5000m_netmode || exit 1
				exit 0
				;;
			get)
				uci -q get h5000m_netmode.settings.eth_fallback || true
				exit 0
				;;
			*)
				echo "Usage: $0 eth-fallback {set <sections>|get}" >&2
				exit 64
				;;
		esac
		;;
	list-devices)
		ip link show 2>/dev/null | sed -n "s/^[0-9]*: \([eu][ths][b0-9a-zA-Z]*\):.*/\1/p" | sort -V
		exit 0
		;;
	get-device-map)
		w=$(uci -q get h5000m_netmode.settings.wan_device 2>/dev/null)
		[ -n "$w" ] || w=$(uci -q get "network.wan.device" 2>/dev/null || uci -q get "network.wan.ifname" 2>/dev/null || echo eth1)
		m=$(uci -q get h5000m_netmode.settings.modem_device 2>/dev/null)
		[ -n "$m" ] || m=eth2
		echo "wan=$w"
		echo "modem=$m"
		exit 0
		;;
	set-device-map)
		case "${2:-}" in
			wan|modem)
				dev="${3:-}"
				[ -n "$dev" ] || { echo "Usage: $0 set-device-map {wan|modem} <device>" >&2; exit 64; }
				uci -q set "h5000m_netmode.settings.${2}_device=${dev}" || exit 1
				uci -q commit h5000m_netmode || exit 1
				exit 0
				;;
			*)
				echo "Usage: $0 set-device-map {wan|modem} <device>" >&2
				exit 64
				;;
		esac
		;;
	set)
		case "${2:-}" in
			wan_first|modem_first|wan_only|modem_only) mode="$2" ;;
			*) echo "invalid exit policy" >&2; exit 64 ;;
		esac
		;;
	reconcile) ;;
	apply|'') ;;
	*) echo "Usage: $0 {status|apply|reconcile|set MODE|eth-fallback|eth-candidates}" >&2; exit 64 ;;
esac

if ! acquire_lock; then
	echo "another exit policy update is already running" >&2
	exit 2
fi
trap release_lock EXIT INT TERM

if [ "$action" = "reconcile" ]; then
	if ! align_ipv6_to_active4; then
		logger -t "$TAG" "failed to align IPv6 with the active IPv4 exit"
		exit 1
	fi
	if ! reload_daed_on_exit_change; then
		exit 1
	fi
	exit 0
fi

if ! apply_policy; then
	logger -t "$TAG" "failed to persist exit policy mode=$mode"
	echo "failed to persist exit policy" >&2
	exit 1
fi

if [ "$action" = "apply" ] || [ "$action" = "set" ]; then
	if ! /etc/init.d/network reload >/dev/null 2>&1; then
		logger -t "$TAG" "network reload failed after applying mode=$mode"
		echo "network reload failed" >&2
		exit 1
	fi
	# Reconcile the dedicated manager after netifd recreates the interfaces.
	if [ -x /usr/sbin/mt5700m-manager ] && ! /usr/sbin/mt5700m-manager sync >/dev/null 2>&1; then
		logger -t "$TAG" "MT5700M manager sync failed after applying mode=$mode"
		echo "MT5700M manager sync failed" >&2
		exit 1
	fi
	# Route both address families through the same live exit. In priority modes
	# this also enables IPv6 on the backup only after IPv4 has failed over.
	sleep 1
	align_ipv6_to_active4 || true
	logger -t "$TAG" "applied exit policy mode=$mode"
fi

if ! reload_daed_on_exit_change; then
	exit 1
fi

exit 0
