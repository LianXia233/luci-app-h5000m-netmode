#!/bin/sh
#
# Trigger a re-evaluation of the exit policy when a participating interface
# changes.
#
# Classification is delegated to the backend rather than re-implemented here.
# The previous version required either the qmodem `modem_config` marker or
# `managed_by=mt5700m` to recognise a modem section, so any layout that carried
# neither (a plain static interface on a cellular netdev, a renamed manager
# section) produced no reconcile at all and a failover went unnoticed until some
# unrelated event happened to fire.
#
# The event is handed to the backend's `notify` worker instead of being acted on
# here.  That worker coalesces a burst of events into one evaluation and delays
# it by `hotplug_debounce` seconds, because a modem re-registering fires several
# ifup/ifdown/ifupdate events in a row and evaluating each one of them separately
# is what produced the duplicate switches and route flapping this design removes.
# The worker also refuses to touch the exit while a switch is in progress.

case "$ACTION" in
	ifup|ifdown|ifupdate|ifcreate) ;;
	*) exit 0 ;;
esac

[ -n "$INTERFACE" ] || exit 0

role="$(/usr/sbin/h5000m-netmode iface-role "$INTERFACE" 2>/dev/null || echo other)"
case "$role" in
	wan|modem) ;;
	*) exit 0 ;;
esac

# Detached and silent: the hotplug helper must not hold netifd waiting on a
# debounce window, and its output must not keep an rpcd pipe open.
(
	/usr/sbin/h5000m-netmode notify "$INTERFACE" "$ACTION" >/dev/null 2>&1
) &

exit 0
