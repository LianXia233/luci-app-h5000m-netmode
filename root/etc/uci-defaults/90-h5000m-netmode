#!/bin/sh
#
# First-install defaults and one-shot migration, executed once per package
# install / first boot.

# Keep the settings section usable even if an older config only carried `mode`.
uci -q get h5000m_netmode.settings >/dev/null 2>&1 || \
	uci -q set h5000m_netmode.settings='settings'

# The watchdog is opt-out: settings.watcher=0 stops the service from registering.
uci -q get h5000m_netmode.settings.watcher >/dev/null 2>&1 || \
	uci -q set h5000m_netmode.settings.watcher='1'
uci -q get h5000m_netmode.settings.watch_interval >/dev/null 2>&1 || \
	uci -q set h5000m_netmode.settings.watch_interval='10'

# Health probing is on by default (opt-out), because the case it exists for - an
# uplink whose interface is proto-up while nothing actually passes - is invisible
# without it.  Installations written by an earlier version carry the old opt-in
# default of 0, which is indistinguishable from a deliberate 0, so that value is
# migrated once; the marker makes any later reinstall respect an operator's 0.
if [ "$(uci -q get h5000m_netmode.settings.health_check)" != "1" ] &&
	[ "$(uci -q get h5000m_netmode.settings.health_check_migrated)" != "1" ]; then
	uci -q set h5000m_netmode.settings.health_check='1'
fi
uci -q set h5000m_netmode.settings.health_check_migrated='1'
uci -q get h5000m_netmode.settings.health_probe_interval >/dev/null 2>&1 || \
	uci -q set h5000m_netmode.settings.health_probe_interval='60'

uci -q commit h5000m_netmode

# Write the policy once so a fresh install starts from a consistent configuration
# instead of waiting for the first hotplug event.
/usr/sbin/h5000m-netmode >/dev/null 2>&1 || true

[ -x /etc/init.d/h5000m-netmode ] && /etc/init.d/h5000m-netmode enable >/dev/null 2>&1

exit 0
