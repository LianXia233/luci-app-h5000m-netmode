config settings 'settings'
	option mode 'wan_first'
	option watcher '1'
	option watch_interval '10'
	option health_check '1'
	option health_probe_interval '60'

	# IPv6 门禁（默认 0）：IPv6 缺失或探测失败一律不阻塞主备切换，
	# 活动出口缺失的族会停靠备用出口的对应路由以阻止分流。
	# 设为 1 恢复强双栈门禁：有 IPv6 成员的出口必须探测通过才允许提升。
	option strict_dual_stack '0'

	# 切换时间预算：所有等待都有上限，超时即按状态机顺序退出并保留可用出口。
	option switch_wait_ipv4 '15'
	option switch_wait_ipv6 '20'
	option switch_budget '60'
	option switch_settle '1'
	option switch_settle_warm '0'

	# 连通性判定与抑制环路：2/3 探测为「可达」，连续 3 轮失败才判出口降级。
	option probe_attempts '3'
	option probe_ok '2'
	option probe_timeout '2'
	option probe_fail_streak '3'
	option switch_cooldown '20'
	option align_confirm '2'

	# Hotplug 事件合并窗口与抢锁等待上限：reconcile 短等让位给切换，
	# 切换/对齐等待较长，避免请求被锁竞争丢弃。
	option hotplug_debounce '2'
	option reconcile_wait '5'
	option switch_lock_wait '10'

	# status 快照 TTL（秒，0 关闭）：前端轮询经快照缓存，减少 ubus/uci 压力。
	option status_cache '3'

	# 健康检查探测目标（可选覆盖，默认如下）：探测经 -I 绑定被检查接口发出。
	option probe_targets '223.5.5.5 119.29.29.29'
	option probe_targets6 '2400:3200::1 2402:4e00::'
