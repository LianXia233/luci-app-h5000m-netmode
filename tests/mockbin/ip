#!/bin/sh
# Mock of `ip`.
#
# Routes live in a table file per family ($H5_SCEN/routes/default4 / default6) and
# this mock emulates the kernel behaviours the backend depends on, which
# tests/run_netns.sh pins against a real kernel:
#
#   * `route replace` is keyed on (destination, metric): replacing a default
#     route in the slot already occupied by another next hop swaps the slot, so a
#     switch is one atomic operation per family;
#   * `route add` at an occupied metric fails with EEXIST, so a switch can never
#     accidentally create an equal-metric pair (multipath);
#   * `route del` only succeeds when gateway, device and metric all match, like
#     the real kernel's nexthop check - which is what makes a stale route object
#     held by netifd harmless.
#
# Addresses come from $H5_SCEN/addr/<dev>, one `family address` pair per line
# (`4 192.168.88.187/24`, `6 2409::1/64`, `6l fe80::1/64` for link-local only).
#
# Every mutating call is appended to $H5_SCEN/route-actions.log in the same shape
# the backend logs, so a test can assert the exact sequence of route operations.
scen="${H5_SCEN:?H5_SCEN not set}"

fam="4"
rest=""
for a in "$@"; do
	case "$a" in
		-4) fam="4" ;;
		-6) fam="6" ;;
		*) rest="$rest $a" ;;
	esac
done
# shellcheck disable=SC2086
set -- $rest

table="$scen/routes/default$fam"
log="$scen/route-actions.log"

mock_table_exists() { [ -f "$table" ]; }

mock_metric() { # <line>
	printf '%s\n' "$1" | awk -v fam="$fam" '
		{
			m = (fam == "6") ? 1024 : 0
			for (i = 1; i < NF; i++)
				if ($i == "metric") m = $(i + 1) + 0
			print m
		}
	'
}

mock_field() { # <line> <field>
	printf '%s\n' "$1" | awk -v f="$2" '{ for (i = 1; i < NF; i++) if ($i == f) { print $(i + 1); exit } }'
}

mock_metric_exists() { # <metric>
	mock_table_exists || return 1
	awk -v key="$1" -v fam="$fam" '
		function metric_of(line,   i, n, a, m) {
			m = (fam == "6") ? 1024 : 0
			n = split(line, a, /[ \t]+/)
			for (i = 1; i <= n; i++)
				if (a[i] == "metric") m = a[i + 1] + 0
			return m
		}
		{ if (metric_of($0) == key) found = 1 }
		END { exit found ? 0 : 1 }
	' "$table"
}

mock_table_write() { # <replace|add|del> <key metric> <new line> <via> <dev>
	local action="$1" key="$2" newline="$3" via="$4" dev="$5" tmp="$table.tmp" rc=0
	mock_table_exists || : > "$table"
	if [ "$action" = "add" ]; then
		printf '%s\n' "$newline" >> "$table"
		return 0
	fi
	awk -v key="$key" -v fam="$fam" -v action="$action" -v newline="$newline" \
		-v via="$via" -v dev="$dev" '
		function metric_of(line,   i, n, a, m) {
			m = (fam == "6") ? 1024 : 0
			n = split(line, a, /[ \t]+/)
			for (i = 1; i <= n; i++)
				if (a[i] == "metric") m = a[i + 1] + 0
			return m
		}
		function field_of(line, f,   i, n, a) {
			n = split(line, a, /[ \t]+/)
			for (i = 1; i <= n; i++)
				if (a[i] == f) return a[i + 1]
			return ""
		}
		{
			if (!done && metric_of($0) == key) {
				if (action == "replace") { print newline; done = 1; next }
				if (action == "del" && field_of($0, "via") == via && field_of($0, "dev") == dev) {
					done = 1
					next
				}
			}
			print $0
		}
		END {
			if (action == "replace" && !done) print newline
			if (action == "del" && !done) exit 3
		}
	' "$table" > "$tmp"
	rc=$?
	mv -f "$tmp" "$table" 2>/dev/null
	return $rc
}

mock_log_route() { # <verb> <args>
	printf 'ip -%s route %s %s\n' "$fam" "$1" "$2" >> "$log"
}

# Failure injection: $H5_SCEN/route-fail holds rules such as
#     dev=eth2 fam=6 verb=replace     # the kernel refuses this one
# and the matching call fails the way the kernel would, which is how the suite
# provokes a half-committed switch without touching a real routing table.
mock_should_fail() { # <verb> <via> <dev>
	local rule match term
	[ -f "$scen/route-fail" ] || return 1
	while IFS= read -r rule || [ -n "$rule" ]; do
		case "$rule" in ''|'#'*) continue ;; esac
		match=1
		for term in $rule; do
			case "$term" in
				dev=*) [ "$3" = "${term#dev=}" ] || match=0 ;;
				fam=*) [ "$fam" = "${term#fam=}" ] || match=0 ;;
				verb=*) [ "$1" = "${term#verb=}" ] || match=0 ;;
				gw=*) [ "$2" = "${term#gw=}" ] || match=0 ;;
				*) match=0 ;;
			esac
			[ "$match" = "1" ] || break
		done
		[ "$match" = "1" ] || continue
		echo "RTNETLINK answers: Operation not permitted" >&2
		return 0
	done < "$scen/route-fail"
	return 1
}

case "${1:-} ${2:-}" in
	"route show")
		dev=""
		[ "${4:-}" = "dev" ] && dev="${5:-}"
		mock_table_exists || exit 1
		if [ -n "$dev" ]; then
			grep -E " dev $dev( |\$)" "$table"
		else
			cat "$table"
		fi
		exit 0
		;;
	"route get")
		probe="${3:-0.0.0.0}"
		f="$scen/routes/get$fam"
		if [ -f "$f" ]; then
			cat "$f"
			exit 0
		fi
		mock_table_exists || exit 1
		line="$(awk -v fam="$fam" '
			function metric_of(line,   i, n, a, m) {
				m = (fam == "6") ? 1024 : 0
				n = split(line, a, /[ \t]+/)
				for (i = 1; i <= n; i++)
					if (a[i] == "metric") m = a[i + 1] + 0
				return m
			}
			{
				m = metric_of($0)
				if (!found || m < best) { found = 1; best = m; line = $0 }
			}
			END { if (found) print line }
		' "$table")"
		[ -n "$line" ] || exit 1
		printf '%s via %s dev %s metric %s\n' "$probe" "$(mock_field "$line" via)" \
			"$(mock_field "$line" dev)" "$(mock_metric "$line")"
		exit 0
		;;
	"route add"|"route replace")
		verb="${2}"
		shift 2
		mock_log_route "$verb" "$*"
		dst="${1:-default}"
		metric="1024"
		[ "$fam" = "4" ] && metric=0
		via=""
		dev=""
		while [ $# -gt 0 ]; do
			case "$1" in
				metric) metric="$2"; shift 2 ;;
				via) via="$2"; shift 2 ;;
				dev) dev="$2"; shift 2 ;;
				*) shift ;;
			esac
		done
		if [ "$verb" = "add" ] && mock_metric_exists "$metric"; then
			echo "RTNETLINK answers: File exists" >&2
			exit 2
		fi
		mock_should_fail "$verb" "$via" "$dev" && exit 2
		mock_table_write "$verb" "$metric" "$dst via $via dev $dev metric $metric"
		exit 0
		;;
	"route del")
		shift 2
		mock_log_route "del" "$*"
		mock_table_exists || exit 2
		metric="1024"
		[ "$fam" = "4" ] && metric=0
		via=""
		dev=""
		while [ $# -gt 0 ]; do
			case "$1" in
				metric) metric="$2"; shift 2 ;;
				via) via="$2"; shift 2 ;;
				dev) dev="$2"; shift 2 ;;
				*) shift ;;
			esac
		done
		mock_should_fail del "$via" "$dev" && exit 2
		if mock_table_write "del" "$metric" "" "$via" "$dev"; then
			exit 0
		fi
		echo "RTNETLINK answers: No such process" >&2
		exit 2
		;;
	"link show")
		[ -f "$scen/links" ] || exit 1
		cat "$scen/links"
		exit 0
		;;
	"addr show")
		dev=""
		[ "${3:-}" = "dev" ] && dev="${4:-}"
		[ -n "$dev" ] || exit 1
		[ -f "$scen/addr/$dev" ] || exit 1
		while IFS= read -r line || [ -n "$line" ]; do
			[ -n "$line" ] || continue
			lfamily="${line%% *}"
			addr="${line#* }"
			case "$lfamily" in
				4) [ "$fam" = "4" ] && printf '    inet %s scope global %s\n' "$addr" "$dev" ;;
				6) [ "$fam" = "6" ] && printf '    inet6 %s scope global\n' "$addr" ;;
				6l) [ "$fam" = "6" ] && printf '    inet6 %s scope link\n' "$addr" ;;
			esac
		done < "$scen/addr/$dev"
		exit 0
		;;
	*)
		exit 1
		;;
esac
