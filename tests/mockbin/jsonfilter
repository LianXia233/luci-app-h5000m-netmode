#!/bin/sh
# Mock of OpenWrt's jsonfilter, supporting the `-e '@.dotted.path'` form.
#
# Pure shell on purpose: the test suite is meant to run on the router too, where
# there is no python, and a process per parsed field would dominate the runtime.
# A missing key prints an empty line, which bool_value() maps to 0 - the same
# observable behaviour as the real jsonfilter for the fields this app reads.
raw=""
while IFS= read -r line || [ -n "$line" ]; do
	raw="$raw$line"
done

emit_value() {
	value="$1"
	# trim surrounding whitespace
	value="${value#"${value%%[![:space:]]*}"}"
	value="${value%"${value##*[![:space:]]}"}"
	# strip one layer of JSON quotes
	case "$value" in
		\"*\") value="${value#\"}"; value="${value%\"}" ;;
	esac
	printf '%s\n' "$value"
}

while [ $# -gt 0 ]; do
	case "$1" in
		-e)
			expr="${2:-}"
			shift 2 2>/dev/null || shift
			field="${expr#@.}"
			[ "$field" = "$expr" ] && field="$expr"
			case "$field" in
				*\**)
					# A wildcard path (`@.*.up`, `@.*.interfaces[*].config.ssid`).
					# The real jsonfilter expands it into one line per match, which
					# is the behaviour the app depends on to count radios.  This
					# mock matches on the leaf key only - every key the app reads
					# through a wildcard (up, ssid, ifname, mac) is unique per
					# object in the fixtures - and prints every match it finds.
					key="${field##*.}"
					matches="$(printf '%s' "$raw" | \
						grep -o "\"$key\"[[:space:]]*:[[:space:]]*[^,}]*" | \
						sed 's/^[^:]*:[[:space:]]*//')"
					[ -n "$matches" ] || exit 0
					printf '%s\n' "$matches" | while IFS= read -r line; do
						emit_value "$line"
					done
					;;
				*)
					emit_value "$(printf '%s' "$raw" | \
						sed -n "s/.*\"$field\"[[:space:]]*:[[:space:]]*\([^,}]*\).*/\1/p")"
					;;
			esac
			;;
		*)
			shift
			;;
	esac
done
exit 0
